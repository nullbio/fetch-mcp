{
  "name": "@nullbio/fetch-mcp",
  "version": "1.1.2",
  "description": "MCP server and CLI for fetching web content as HTML, Markdown, plain text, JSON, or YouTube transcripts",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "zcaceres (@zachcaceres zach.dev)",
  "contributors": [
    "pwilkin (ilintar@gmail.com)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nullbio/fetch-mcp.git"
  },
  "homepage": "https://github.com/nullbio/fetch-mcp#readme",
  "bugs": {
    "url": "https://github.com/nullbio/fetch-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "dev": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "mcp-fetch-server": "dist/index.js",
    "mcp-fetch": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "mcp",
    "fetch",
    "web",
    "scrape",
    "markdown",
    "youtube",
    "transcript"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "28.1.0",
    "turndown": "7.2.4",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/mozilla__readability": "0.4.2",
    "@types/node": "26.6.4",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0"
}
